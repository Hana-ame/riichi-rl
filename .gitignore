# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytype/
.mypy_cache/

# --- Logs / 运行产物 ---
*.log
*.jsonl.tmp
probe_once.jsonl

# --- 第三方 vendored 引擎自身的 Python 缓存 ---
vendor/**/__pycache__/
vendor/**/__pycache__
vendor/**/*.pyc

# --- 模型权重 / checkpoints（不进 git；磁盘保留）---
# 只允许例外：checkpoints/bc_v1_last.pt（当前最佳 BC 教师 ckpt，
#   用于复现 train_bc.py 结果；如需换 ckpt，同步修改下面的 ! 行）
checkpoints/*.pt
checkpoints/*.pth
checkpoints/*.safetensors
checkpoints/*.ckpt
*.pt
*.pth
*.safetensors
*.ckpt
!checkpoints/bc_v1_last.pt

# --- 大体积可再生数据（不入库，用 data/dl_houou.sh + build_all.sh 重建）---
# 原始天鳳鳳凰室牌谱 shard（~528M，来源 1nfrared218/tenhou-mjai-riichi-training）
data/houou/*.tar
data/houou/*.tar.part
# build_cache.py 的编译产物（~585M，从 *.tar 编译）
data/cache/*.npz
# 可再生训练 npz 数据集（>100MB 超 GitHub 单文件硬限制，用 build_all.sh 重建）
data/*.npz
# 下载 / 编译残留
data/*.part
data/*.tmp

# --- 可再生对局数据 / 观战截图（2026-11-04）---
data/selfplay/
data/bc2/
browser-screenshots/

# 教师 BC 数据集（可再生成，2026-11-05）
data/teacher*.npz

# --- 外部模型/权重（2026-11-05，下载自第三方，不入库）---
external/

# arena/gate 运行时副产物（可再生，不入库）
rules/ELO.json
rules/SELFPLAY_GATE_*.json
rules/OPP_SHANTEN_LEAK_*.json

# --- 大体积教师数据（>100MB，不入库；用 generate 脚本重建）---
rules/*_teacher.npz
